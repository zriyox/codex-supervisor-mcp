{
  "name": "codex-supervisor-mcp",
  "version": "0.13.5",
  "mcpName": "io.github.zriyox/codex-supervisor-mcp",
  "type": "module",
  "description": "MCP server that dispatches and supervises parallel Codex CLI workers, one isolated Git worktree each, with a persisted work state machine.",
  "homepage": "https://codex-supervisor.zriyo.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zriyox/codex-supervisor-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zriyox/codex-supervisor-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude",
    "orchestration",
    "multi-agent",
    "worktree",
    "supervisor"
  ],
  "bin": {
    "codex-supervisor-mcp": "src/mcp-server.js",
    "codex-supervisor-accept": "src/interface/bin/acceptance-cli.js",
    "codex-supervisor-setup": "src/interface/bin/setup.js",
    "codex-supervisor-web": "src/interface/bin/web-server.js",
    "codex-supervisor-stage": "src/interface/bin/stage.js"
  },
  "files": [
    "src",
    "web/dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./src/interface/bin/setup.js --auto --quiet",
    "setup": "node ./src/interface/bin/setup.js",
    "start": "node ./src/mcp-server.js",
    "monitor": "tsx ./src/interface/bin/monitor.jsx",
    "cleanup": "node ./src/interface/bin/cleanup.js",
    "lint": "eslint .",
    "test": "node ./test/scripts/bin-resolver-test.js && node ./test/scripts/truncate-test.js && node ./test/scripts/status-test.js && node ./test/scripts/migration-test.js && node ./test/scripts/setup-test.js && node ./test/scripts/setup-windows-test.js && node ./test/scripts/regression-test.js && node --test test/edge/*.test.js",
    "test:real": "node ./test/scripts/real-codex-test.js",
    "test:real:multi": "node ./test/scripts/multi-project-real-test.js",
    "smoke": "node ./test/scripts/smoke-test.js",
    "smoke:followup": "node ./test/scripts/followup-smoke-test.js",
    "smoke:mcp": "node ./test/scripts/mcp-smoke-test.js",
    "smoke:mcp-wait": "node ./test/scripts/mcp-wait-smoke-test.js",
    "web": "node ./src/interface/bin/web-server.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "test:edge": "node --test test/edge/*.test.js",
    "prepublishOnly": "npm run web:build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0"
  },
  "optionalDependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
